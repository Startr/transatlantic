# Hidden-artifact allowlist: deny dotfiles and dotfolders everywhere in the
# repo unless they are intentionally shared and explicitly included below.
.*
!/.gitignore
!/.gitattributes
!/.editorconfig
!/.claude-plugin/
!/.claude-plugin/**
!/.codex/
!/.codex/**
!/.github/
!/.github/**
# Nested tracked dotfiles/dirs (no leading slash — match at any depth)
!.nojekyll
!.gitkeep
!.codex-plugin/
!.codex-plugin/**
!.todoscope-exclude.csv
# .env.example at any depth (no leading slash). Keep this note on its OWN line —
# gitignore has no inline comments; a trailing comment becomes part of the pattern.
!.*.example

# Non-dot build & runtime junk
benchmarks/results/*.json
__pycache__/
*.pyc
evals/snapshots/*.html
evals/snapshots/*.png
context/refs/research-brief-caveman-code-efficiency.md

# Build artifacts
dist/*
!dist/transatlantic.skill
